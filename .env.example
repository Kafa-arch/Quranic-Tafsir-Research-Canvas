# NEVER commit the real secret to GitHub.
GROQ_API_KEY=put_your_rotated_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Paste your PRIVATE QTRC system instructions here in your backend deployment.
QTRC_SYSTEM_PROMPT=replace_with_your_private_qtrc_system_prompt

# Comma-separated GitHub Pages origin(s). Use * for testing only.
ALLOWED_ORIGINS=https://YOUR-USERNAME.github.io

# Preferred AI gateway: LiteLLM Proxy

# LiteLLM provider keys (stored ONLY on the LiteLLM host)
GEMINI_API_KEY=replace_with_gemini_key
OPENROUTER_API_KEY=replace_with_openrouter_key

# Supabase cloud file storage
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key
